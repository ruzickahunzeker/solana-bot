[Unit]
Description=PumpAPI watched-wallet event recorder
Wants=network-online.target pumpapi-zmq-bridge.service
After=network-online.target pumpapi-zmq-bridge.service

[Service]
Type=simple
User=root
WorkingDirectory=/root/solana/pumpapi_zmq_bridge
ExecStart=/root/solana/pumpapi_zmq_bridge/.venv/bin/python /root/solana/pumpapi_zmq_bridge/wallet_watch_recorder.py
Restart=always
RestartSec=2
UMask=0077
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target

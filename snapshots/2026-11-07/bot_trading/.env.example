TELEGRAM_BOT_TOKEN=
ALLOWED_TELEGRAM_USER_IDS=123456789
RUST_LOG=bot_trading=info

DATABASE_URL=sqlite://./data/copy_trading.sqlite
MASTER_KEY_HEX=

PUMPAPI_ZMQ_ENDPOINT=tcp://127.0.0.1:8939
FOLLOW_WALLET_A=
ENABLE_STREAM_CONSUMER=true
ENABLE_TELEGRAM_BOT=true

TRADE_SERVICE_URL=http://127.0.0.1:18788
TRADE_SERVICE_TOKEN=
TRADE_ROUTE_DECISION_URL=
TRADE_ROUTE_DECISION_TOKEN=
TRADE_SERVICE_TIMEOUT_SECS=15
POOL_RESOLVE_TIMEOUT_SECS=6
TRADE_SUBMIT_MAX_ATTEMPTS=2
TRADE_SUBMIT_RETRY_DELAY_MS=250
TRADE_RECONCILE_INTERVAL_SECS=2
FAST_FOLLOW_ENABLED=true
FAST_FOLLOW_MAX_INFLIGHT=16
FAST_FOLLOW_CACHE_REFRESH_MS=5000
FAST_FOLLOW_LIMIT_QUEUE_CAPACITY=4096

DRY_RUN_DEFAULT=true
MIGRATE_LOCAL_WALLETS_TO_TRADE_SERVICE=false
DEFAULT_BUY_AMOUNT_SOL=0.01
QUICK_BUY_PRESET_1_SOL=0.001
QUICK_BUY_PRESET_2_SOL=0.005
QUICK_BUY_PRESET_3_SOL=0.01
QUICK_BUY_PRESET_4_SOL=0.05
QUICK_BUY_PRESET_5_SOL=0.1
QUICK_SELL_PRESET_1_PERCENT=10
QUICK_SELL_PRESET_2_PERCENT=25
QUICK_SELL_PRESET_3_PERCENT=50
QUICK_SELL_PRESET_4_PERCENT=75
QUICK_SELL_PRESET_5_PERCENT=100
DEFAULT_SLIPPAGE_BPS=1500
DEFAULT_TIP_SOL=0.0001
USE_MEV=false
DEFAULT_MEV_PROVIDER=auto
SOL_USD_PRICE=
SOL_USD_PRICE_API_URL=https://api.jup.ag/price/v3
JUP_PRICE_API_KEY=
SOL_USD_REFRESH_SECS=60

# Blocks primary trade submissions and recovery. The isolated SDK simulation
# switch below is separate, defaults off, and only permits manual Simulate + SDK.
TRADE_SUBMISSION_ENABLED=false
TRADE_ISOLATED_SDK_SIMULATION_ENABLED=false

# Optional read-only SOL opening-day PnL. Keep the real token in .env (0600).
WEB_API_BASE_URL=
WEB_API_TOKEN=
# Read-only position subscription wallet addresses, comma-separated. No private keys.
PNL_POSITION_WALLETS=

# Alpha observation/paper signal path. Paper signals never call Trade Service.
ALPHA_PAPER_ENABLED=true
ALPHA_PAPER_MIN_SCORE=0.80
ALPHA_PAPER_MIN_TRADERS=5
ALPHA_RETENTION_ENABLED=true
ALPHA_RETENTION_INTERVAL_SECS=900
ALPHA_OBSERVATION_RETENTION_HOURS=72
ALPHA_PAPER_SIGNAL_RETENTION_DAYS=7
ALPHA_OBSERVATION_MAX_ROWS=50000
ALPHA_PAPER_SIGNAL_MAX_ROWS=20000
ALPHA_RETENTION_BATCH_SIZE=1000
ALPHA_PAPER_PERSIST_OBSERVATIONS=false
ALPHA_PAPER_MAX_OBSERVATION_BYTES=4096
ALPHA_PAPER_SIGNAL_COOLDOWN_SECS=600

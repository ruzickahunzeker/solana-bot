[Unit]
Description=SSH tunnel to trade service on 10.9.0.15
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=root
ExecStart=/usr/bin/ssh -N -T -i /root/.ssh/id_ed25519_trade_tunnel -o IdentitiesOnly=yes -o BatchMode=yes -o StrictHostKeyChecking=yes -o UserKnownHostsFile=/root/.ssh/trade_tunnel_known_hosts -o ExitOnForwardFailure=yes -o ConnectTimeout=5 -o ServerAliveInterval=15 -o ServerAliveCountMax=3 -L 127.0.0.1:18788:127.0.0.1:18787 trade-tunnel@10.9.0.15
Restart=always
RestartSec=5
TimeoutStopSec=10
UMask=0077
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
